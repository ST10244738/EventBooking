@model EventBooking.Models.Event

<h2>Create Event</h2>

<form asp-action="Create">

    <label>Name</label>
    <input asp-for="EventName" />

    <label>Date</label>
    <input asp-for="EventDate" type="date" />

    <label>Description</label>
    <input asp-for="Description" />

    <label>Venue</label>
    <select asp-for="VenueId" asp-items="ViewBag.Venues"></select>

    <button>Create</button>

</form>