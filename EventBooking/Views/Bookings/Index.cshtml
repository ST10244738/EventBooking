@model IEnumerable<EventBooking.Models.BookingDetailsViewModel>

@{
    ViewData["Title"] = "Bookings";
}

<h2 class="mb-3">Bookings</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error:</strong> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-semibold">Search</label>
                <input type="text" name="search" value="@ViewBag.Search"
                       class="form-control" placeholder="Booking ID or Event Name..." />
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold">Event Type</label>
                <select name="eventTypeId" class="form-select" asp-items="ViewBag.EventTypes">
                    <option value="">All Types</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold">From Date</label>
                <input type="date" name="startDate" value="@ViewBag.StartDate" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold">To Date</label>
                <input type="date" name="endDate" value="@ViewBag.EndDate" class="form-control" />
            </div>
            <div class="col-md-2 d-flex align-items-end pb-1">
                <div class="form-check form-switch ms-1">
                    <input class="form-check-input" type="checkbox" name="availableOnly" value="true"
                           id="availableOnly" @(ViewBag.AvailableOnly == true ? "checked" : "") />
                    <label class="form-check-label" for="availableOnly">Available Venues Only</label>
                </div>
            </div>
            <div class="col-md-1 d-flex gap-1">
                <button type="submit" class="btn btn-primary w-100">Filter</button>
            </div>
        </form>
        <div class="mt-2">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Clear Filters</a>
        </div>
    </div>
</div>

<div class="mb-3 text-end">
    <a asp-action="Create" class="btn btn-success">+ New Booking</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No bookings found matching the selected filters.</div>
}
else
{
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Booking ID</th>
                <th>Booking Date</th>
                <th>Event</th>
                <th>Event Type</th>
                <th>Event Date</th>
                <th>Description</th>
                <th>Venue</th>
                <th>Location</th>
                <th>Capacity</th>
                <th>Available</th>
                <th>Venue Image</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var b in Model)
            {
                <tr>
                    <td><span class="badge bg-secondary">#@b.BookingId</span></td>
                    <td>@b.BookingDate.ToString("yyyy-MM-dd")</td>
                    <td><strong>@b.EventName</strong></td>
                    <td>
                        @if (!string.IsNullOrEmpty(b.EventTypeName))
                        {
                            <span class="badge bg-info text-dark">@b.EventTypeName</span>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td>@b.EventDate.ToString("yyyy-MM-dd")</td>
                    <td>@b.Description</td>
                    <td>@b.VenueName</td>
                    <td>@b.Location</td>
                    <td>@b.Capacity</td>
                    <td>
                        @if (b.IsAvailable)
                        {
                            <span class="badge bg-success">Available</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Unavailable</span>
                        }
                    </td>
                    <td>
                        @if (!string.IsNullOrEmpty(b.VenueImageUrl))
                        {
                            <img src="@b.VenueImageUrl" style="max-height:50px;" class="rounded" />
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Delete" asp-route-id="@b.BookingId"
                           class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
