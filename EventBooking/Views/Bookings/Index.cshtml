@model IEnumerable<EventBooking.Models.BookingDetailsViewModel>

@{
    ViewData["Title"] = "Bookings";
}

<h2 class="mb-3">Bookings</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error:</strong> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex gap-2 mb-3">
    <form method="get" class="d-flex gap-2 flex-grow-1">
        <input type="text" name="search" value="@ViewBag.Search"
               class="form-control" placeholder="Search by Booking ID or Event Name..." />
        <button type="submit" class="btn btn-primary">Search</button>
        <a asp-action="Index" class="btn btn-secondary">Clear</a>
    </form>
    <a asp-action="Create" class="btn btn-success">+ New Booking</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No bookings found.</div>
}
else
{
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Booking ID</th>
                <th>Booking Date</th>
                <th>Event</th>
                <th>Event Date</th>
                <th>Description</th>
                <th>Venue</th>
                <th>Location</th>
                <th>Capacity</th>
                <th>Venue Image</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var b in Model)
            {
                <tr>
                    <td><span class="badge bg-secondary">#@b.BookingId</span></td>
                    <td>@b.BookingDate.ToString("yyyy-MM-dd")</td>
                    <td><strong>@b.EventName</strong></td>
                    <td>@b.EventDate.ToString("yyyy-MM-dd")</td>
                    <td>@b.Description</td>
                    <td>@b.VenueName</td>
                    <td>@b.Location</td>
                    <td>@b.Capacity</td>
                    <td>
                        @if (!string.IsNullOrEmpty(b.VenueImageUrl))
                        {
                            <img src="@b.VenueImageUrl" style="max-height:50px;" class="rounded" />
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Delete" asp-route-id="@b.BookingId"
                           class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
