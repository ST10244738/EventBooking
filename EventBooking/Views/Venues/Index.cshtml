@model IEnumerable<EventBooking.Models.Venue>

@{
    ViewData["Title"] = "Venues";
}

<h2 class="mb-3">Venues</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error:</strong> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex gap-2 mb-3">
    <form method="get" class="d-flex gap-2 flex-grow-1">
        <input type="text" name="search" value="@Context.Request.Query["search"]"
               class="form-control" placeholder="Search by venue name..." />
        <button type="submit" class="btn btn-primary">Search</button>
        <a asp-action="Index" class="btn btn-secondary">Clear</a>
    </form>
    <a asp-action="Create" class="btn btn-success">+ Add Venue</a>
</div>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Name</th>
            <th>Location</th>
            <th>Capacity</th>
            <th>Image</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var v in Model)
        {
            <tr>
                <td>@v.VenueName</td>
                <td>@v.Location</td>
                <td>@v.Capacity</td>
                <td>
                    @if (!string.IsNullOrEmpty(v.ImageUrl))
                    {
                        <img src="@v.ImageUrl" style="max-height:60px;" />
                    }
                    else
                    {
                        <span class="text-muted">No image</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@v.VenueId" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@v.VenueId" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
